#!/usr/bin/env bash
# Root-only helper installed by install.sh. Input is generated by the panel.
set -euo pipefail
payload="${1:?missing endpoint payload}"
hba="$(find /etc/postgresql -name pg_hba.conf -type f | head -n1)"
conf="$(find /etc/postgresql -name postgresql.conf -type f | head -n1)"
[[ -n "$hba" && -n "$conf" ]] || { echo "PostgreSQL configuration was not found" >&2; exit 1; }
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
printf '%s\n' "$payload" | while IFS='|' read -r host rule cidrs; do
  [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || exit 1
  [[ "$rule" == hostssl || "$rule" == hostnossl ]] || exit 1
  IFS=',' read -ra ranges <<< "$cidrs"
  for cidr in "${ranges[@]}"; do printf '%s all all %s scram-sha-256\n' "$rule" "$cidr" >> "$tmp"; done
done
cp "$hba" "$hba.srv-panel.bak"
sed -i '/# BEGIN srv-panel postgres remote/,/# END srv-panel postgres remote/d' "$hba"
{ echo '# BEGIN srv-panel postgres remote'; cat "$tmp"; echo '# END srv-panel postgres remote'; } >> "$hba"
sed -i "s/^#\?listen_addresses.*/listen_addresses = '*'/" "$conf"
if grep -q '^hostssl' "$tmp"; then
  first_host="$(printf '%s\n' "$payload" | awk -F'|' '$2=="hostssl"{print $1; exit}')"
  sed -i "s|^#\?ssl_cert_file.*|ssl_cert_file = '/etc/letsencrypt/live/$first_host/fullchain.pem'|" "$conf"
  sed -i "s|^#\?ssl_key_file.*|ssl_key_file = '/etc/letsencrypt/live/$first_host/privkey.pem'|" "$conf"
  sed -i 's/^#\?ssl.*/ssl = on/' "$conf"
fi
systemctl reload postgresql
